# --- Identifiants Powens (Console Powens > ton domaine > Applications) ---
# Nom de domaine Powens SANS ".biapi.pro", ex: si ton domaine est "monapp-sandbox.biapi.pro",
# mets juste "monapp-sandbox"
POWENS_DOMAIN=

POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=

# URL de callback declaree dans la console Powens pour ce client (doit correspondre exactement)
POWENS_REDIRECT_URI=https://localhost:3000/callback

# Port local de l'appli
PORT=3000

# Optionnel : si defini, obligatoire pour creer un nouveau compte (protege
# l'appli des inscriptions ouvertes a n'importe qui si l'URL venait a fuiter,
# surtout utile une fois deploye publiquement sur Render).
# SIGNUP_CODE=change-moi
